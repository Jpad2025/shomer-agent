# Secretos y datos locales — NUNCA hacer push de esto
.env
.env.*
!.env.example
data/
# 12 sep 2026: core/data/ es CONTENIDO del producto (conocimiento validado,
# generico para cualquier cliente), no datos de un sitio -- distinto del
# "data/" de la raiz (devices.json, knowledge.db, descargas: eso si es por
# sitio y nunca se versiona). Excepcion puntual, mismo criterio que
# .env.example arriba.
!core/data/
!core/data/*.json
*.db
*.db-*
*.sqlite
*.sqlite3

# Runtime / build
__pycache__/
*.pyc
*.pyo
*.log
logs/
venv/
.venv/
.venv-test/
.pytest_cache/

# Editor / local
.cursor*
*.bak
*.bak.*
